# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 3 MB 应用上限与固定保护分区保持一致。分区表保留
# cardid@0x356000，二创不得移动或覆盖。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# CS 看板要用到更大字号显示比分/当前字符。
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# CS 看板对象较多(比分卡 + 地图行 + Wi-Fi 列表),32KB 留出余量。
CONFIG_LV_MEM_SIZE_KILOBYTES=32

# 中文字体(cs_font_cn16)位图约 380KB,glyph 位图偏移会超过 64KB,
# 开启 32 位位图索引,避免定点截断导致字形错乱。
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# cs_font_cn16 由 lv_font_conv 以 --format lvgl(默认压缩)生成,
# bitmap_format=1(LV_FONT_FMT_TXT_COMPRESSED)。LVGL 解码压缩字体必须开此开关,
# 否则字形 bitmap 全空、中文标签只留框架不画字(配网页/状态栏中文均空白)。
# 体积:压缩位图约 296KB;若改为 --no-compress 未压缩约 492KB(多占 ~196KB),
# 当前 app 余量仅 ~282KB,故保持压缩 + 仅开此解码开关最稳妥。
CONFIG_LV_USE_FONT_COMPRESSED=y

# --- HTTPS / 联网数据 ---
# 数据源走 https(jsDelivr CDN),需要根证书包来做 TLS 校验。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# 状态栏要显示北京时间,连上 Wi-Fi 后用 SNTP 同步。
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
